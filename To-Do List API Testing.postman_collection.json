  "item": [
    {
      "name": "TC01 - Verify GET Request Retrieves a To-Do by ID",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status code is 200\",function(){\r\n    pm.response.to.have.status(200);\r\n});\r\npm.test(\"Response contains a task title\",function(){\r\n    const data = pm.response.json();\r\n    pm.expect(data.title).to.be.a(\"string\");\r\n});\r\npm.test(\"Task Id is 1\",function(){\r\n    const data = pm.response.json();\r\n    pm.expect(data.id).to.eql(1);\r\n});\r\npm.test(\"Completed field is a boolean\",function(){\r\n    const data = pm.response.json();\r\n    pm.expect(data.completed).to.be.a(\"boolean\");\r\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"userID\" : 1,\r\n    \"id\" : 1,\r\n    \"tile\" : \"delectus aut autem\",\r\n    \"completed\" : false\r\n\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "https://jsonplaceholder.typicode.com/todos/1",
          "protocol": "https",
          "host": [
            "jsonplaceholder",
            "typicode",
            "com"
          ],
          "path": [
            "todos",
            "1"
          ]
        }
      },
      "response": []
    },
